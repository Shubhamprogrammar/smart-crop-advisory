# Server
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# Hugging Face
HF_API_TOKEN=
# Fallback chat model (used only for a language with no entry in
# MODEL_BY_LANGUAGE in chat_service.py — normally none, since the app only
# sends en/hi/mr/gu). Per-language models are chosen in code, not env vars,
# because they were picked from live quality testing per language.
CHAT_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Vector store — MongoDB Atlas Vector Search requires an Atlas-managed
# cluster; this app's local/dev MongoDB has neither Atlas nor a self-hosted
# `mongot`, so Qdrant is used per the spec's own documented fallback.
# For local dev: docker run -p 6333:6333 qdrant/qdrant, then QDRANT_URL=http://localhost:6333
MONGO_URI=
QDRANT_URL=http://localhost:6333

# Model artifacts
MODEL_PATH=./app/ml/artifacts
